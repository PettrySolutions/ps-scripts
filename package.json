{
  "name": "@pettry-solutions/scripts",
  "version": "1.0.2",
  "description": "Modular CLI tools for various utilities",
  "main": "dist/index.js",
  "bin": {
    "ztc": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "ts-node src/cli.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "prepublishOnly": "npm run build && npm test",
    "clean": "rm -rf dist",
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "changeset:publish": "changeset publish",
    "release": "npm run build && npm test && changeset publish"
  },
  "keywords": [
    "cli",
    "tools",
    "utilities",
    "import-mapping",
    "typescript",
    "javascript"
  ],
  "author": "Dakotah Pettry",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/PettrySolutions/ps-scripts.git"
  },
  "bugs": {
    "url": "https://github.com/PettrySolutions/ps-scripts/issues"
  },
  "homepage": "https://github.com/PettrySolutions/ps-scripts#readme",
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.8",
    "@types/jest": "^29.5.11",
    "@types/node": "^20.11.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "commander": "^11.1.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
